# Copy to .env and edit. All values optional.
HOST=127.0.0.1
PORT=3000
# Local model server (Ollama default). For llama.cpp's llama-server use http://127.0.0.1:8080
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.2
# offline = block all non-localhost network calls, online = allow them
DEFAULT_MODE=offline
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_PER_MIN=30
MAX_MESSAGE_CHARS=8000
MAX_CONTEXT_CHARS=24000

# --- Agent (Phase 2) ---
# Folder the agent may read/write/run in (default: ./workspace)
WORKSPACE_DIR=./workspace
# true = write_file runs without asking. run_command ALWAYS asks.
AUTO_APPROVE_WRITES=false
# Programs run_command may start (comma separated)
ALLOWED_COMMANDS=node,python3,python
AGENT_MAX_STEPS=8
COMMAND_TIMEOUT_MS=30000
